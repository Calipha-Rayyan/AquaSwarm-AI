# ---- AI agents (Gemini) ------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here 
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Data -------------------------------------------------------------
# Real deployments start EMPTY: add sites, tanks, readings and suppliers in
# the app (Data and Suppliers pages). Sample CSV data is only loaded when
# this is true (demos and automated tests).
AQUASWARM_SEED_DEMO_DATA=false

# ---- Backend -----------------------------------------------------------
# inprocess = the app talks to the database directly (Streamlit Cloud / single machine)
# http      = a separate FastAPI server (needed for sensors posting readings)
# auto      = try http, fall back to inprocess only if the server is not running
# (no quotes, no spaces around "=")
AQUASWARM_BACKEND_MODE=inprocess
AQUASWARM_API_URL=http://127.0.0.1:8000
AQUASWARM_BACKEND_TIMEOUT=5

# Shared secret for HTTP mode (sent as X-API-Key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AQUASWARM_API_KEY=
AQUASWARM_ENABLE_DOCS=false
AQUASWARM_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---- Water operating policy -------------------------------------------
AQUASWARM_DEFAULT_INFLOW=0
AQUASWARM_RESERVE_DAYS=7
AQUASWARM_MIN_OPERATING_FILL_PCT=40
AQUASWARM_MAX_FILL_PCT=95

# ---- E-mail notifications (optional) -----------------------------------
# Alerts to managers, password-reset codes and access-request notices are
# sent only when a host is set. Leave empty to disable.
AQUASWARM_SMTP_HOST=
AQUASWARM_SMTP_PORT=587
AQUASWARM_SMTP_USER=
AQUASWARM_SMTP_PASSWORD=
AQUASWARM_SMTP_FROM=

# NOTE: there are no built-in logins any more. The first person to open the
# app creates the administrator account; everyone else requests access.