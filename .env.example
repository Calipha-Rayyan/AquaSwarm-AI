# Gemini API
GEMINI_API_KEY=YOUR_REAL_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# AquaSwarm backend
AQUASWARM_BACKEND_ENABLED=true
AQUASWARM_BACKEND_MODE = "inprocess"
AQUASWARM_API_URL=http://127.0.0.1:8000
AQUASWARM_BACKEND_TIMEOUT=1.0
AQUASWARM_DEFAULT_INFLOW=0

# Prototype manager login
AQUASWARM_DEMO_EMAIL=demo@aquaswarm.ai
AQUASWARM_DEMO_PASSWORD=AquaSwarm@123
