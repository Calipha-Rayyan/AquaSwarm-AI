# ---- Agents (Gemini) ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Backend -----------------------------------------------------------
# inprocess = Streamlit calls the backend code directly (use on Streamlit Cloud)
# http      = Streamlit calls a running FastAPI server with the API key
# auto      = try http, use inprocess only if the server is not running
# (no quotes, no spaces around "=")
AQUASWARM_BACKEND_MODE=inprocess
AQUASWARM_API_URL=http://127.0.0.1:8000
AQUASWARM_BACKEND_TIMEOUT=5

# Shared secret for HTTP mode (sent as X-API-Key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the same value for the server and for Streamlit.
AQUASWARM_API_KEY=
# Interactive /docs are off by default; set true only for local debugging.
AQUASWARM_ENABLE_DOCS=false
AQUASWARM_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---- Water operating policy (see tools/water_tools.py) -----------------
AQUASWARM_DEFAULT_INFLOW=0
AQUASWARM_RESERVE_DAYS=7
AQUASWARM_MIN_OPERATING_FILL_PCT=40
AQUASWARM_MAX_FILL_PCT=95


# ---- Manager login (change before any shared demo) ---------------------
AQUASWARM_DEMO_EMAIL=demo@aquaswarm.ai
AQUASWARM_DEMO_PASSWORD=AquaSwarm@123
